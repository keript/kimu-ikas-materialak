{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ficha A4 de Kimu",
  "description": "Una ficha = un archivo en contenido/fitxak/<id>.json. Genera <id>.html con las hojas A4 listas para imprimir. Los bloques se explican en docs/fichas.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "arlo",
    "seccion",
    "orden",
    "publicado",
    "curso",
    "tipo_material",
    "nombre",
    "titulo_resalte",
    "icono",
    "resumen",
    "descripcion_meta",
    "color",
    "hojas"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "arlo": {
      "type": "string"
    },
    "seccion": {
      "type": "string"
    },
    "orden": {
      "type": "integer",
      "minimum": 1
    },
    "publicado": {
      "type": "boolean"
    },
    "curso": {
      "enum": [
        "LH 3",
        "LH 4",
        "LH 3-4"
      ]
    },
    "tipo_material": {
      "enum": [
        "Gaiaren laburpena",
        "Pausoz pauso",
        "Idazketa-txantiloia",
        "Horma-irudia",
        "Ariketa-fitxa",
        "Irakurmena"
      ]
    },
    "nombre": {
      "type": "string",
      "maxLength": 40
    },
    "titulo_resalte": {
      "type": "string",
      "maxLength": 40
    },
    "icono": {
      "type": "string",
      "maxLength": 8
    },
    "resumen": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140
    },
    "descripcion_meta": {
      "type": "string",
      "minLength": 20,
      "maxLength": 160
    },
    "color": {
      "enum": [
        "verde",
        "azul",
        "rojo",
        "naranja",
        "morado",
        "turquesa"
      ]
    },
    "soluciones": {
      "type": "boolean",
      "description": "true = añade al final una hoja de zuzenketa con las soluciones de los ejercicios"
    },
    "hojas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titulo",
          "bloques"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 34
          },
          "subtitulo": {
            "type": "string",
            "maxLength": 110
          },
          "color": {
            "enum": [
              "verde",
              "azul",
              "rojo",
              "naranja",
              "morado",
              "turquesa"
            ]
          },
          "orientacion": {
            "enum": [
              "vertical",
              "horizontal"
            ]
          },
          "datos": {
            "type": "boolean",
            "description": "false = sin línea de Izena / Data (pósters)"
          },
          "bloques": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "tipo"
              ]
            }
          },
          "tamano": {
            "enum": [
              "normal",
              "grande"
            ],
            "description": "grande = letra y tarjetas más grandes (hojas de teoría con poco texto)"
          }
        }
      }
    },
    "lugar": {
      "enum": [
        "teoria",
        "actividades"
      ],
      "description": "En secciones normales: teoria = aparece en Arauak; actividades = aparece en Fitxak. Por defecto teoria."
    },
    "relacionada": {
      "type": "string",
      "description": "id de la ficha compañera (teoría ↔ ejercicios). Su página muestra un botón para ir a ella."
    },
    "numeracion_continua": {
      "type": "boolean",
      "description": "true = los ejercicios se numeran seguidos en todas las hojas (lecturas con preguntas)"
    },
    "generado": {
      "type": "boolean",
      "description": "true = la genera scripts/generar_retos.py (no editar a mano: se sobrescribe)"
    },
    "publicar_desde": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Fecha (AAAA-MM-DD) a partir de la cual se publica. Antes no aparece en la web. La web se regenera sola cada mañana."
    }
  }
}