{
 "id": "bingoa-euskararen-eguna",
 "kodea": "EE",
 "izenburua": "Euskararen Eguneko bingoa",
 "maila": "LH 3",
 "hitzak": [
  {
   "hitza": "EUSKARA",
   "definizioa": "Euskal Herrian hitz egiten dugun hizkuntza."
  },
  {
   "hitza": "HIZKUNTZA",
   "definizioa": "Pertsonek elkarren artean komunikatzeko erabiltzen dute. Euskara bat da."
  },
  {
   "hitza": "HIZTEGIA",
   "definizioa": "Hitzen esanahia bilatzeko liburua."
  },
  {
   "hitza": "BERTSOA",
   "definizioa": "Neurriarekin eta errimarekin kantatzen den testua."
  },
  {
   "hitza": "BERTSOLARIA",
   "definizioa": "Bertsoak bat-batean asmatu eta kantatzen dituen pertsona."
  },
  {
   "hitza": "TXALAPARTA",
   "definizioa": "Bi pertsonak oholak makilekin joz jotzen duten musika-tresna."
  },
  {
   "hitza": "TRIKITIXA",
   "definizioa": "Akordeoi txiki bat da. Panderoarekin batera jotzen da."
  },
  {
   "hitza": "ESAERA",
   "definizioa": "Aspalditik datorren esaldi jakintsua."
  },
  {
   "hitza": "IPUINA",
   "definizioa": "Kontatzen den istorio laburra. «Behin batean…» hasten da askotan."
  },
  {
   "hitza": "ABESTIA",
   "definizioa": "Musikarekin kantatzen dugun testua."
  },
  {
   "hitza": "OLERKIA",
   "definizioa": "Lerro laburretan idatzitako testua. Askotan errima du."
  },
  {
   "hitza": "LIBURUTEGIA",
   "definizioa": "Liburuak irakurtzeko eta etxera eramateko lekua."
  },
  {
   "hitza": "IDAZLEA",
   "definizioa": "Liburuak idazten dituen pertsona."
  },
  {
   "hitza": "ALFABETOA",
   "definizioa": "Hizkuntza bateko letra guztiak, ordenan."
  },
  {
   "hitza": "HITZA",
   "definizioa": "Letraz osatuta dago eta esanahia du."
  },
  {
   "hitza": "ESALDIA",
   "definizioa": "Hitz batzuek osatzen dute. Letra larriz hasi eta puntuarekin bukatzen da."
  },
  {
   "hitza": "AGURRA",
   "definizioa": "«Kaixo!» edo «Agur!» esaten dugunean egiten duguna."
  },
  {
   "hitza": "ELKARRIZKETA",
   "definizioa": "Bi pertsonak edo gehiagok elkarri hitz egiten diotenean."
  },
  {
   "hitza": "KORRIKA",
   "definizioa": "Euskararen alde Euskal Herria zeharkatzen duen lasterketa."
  },
  {
   "hitza": "EUSKALDUNA",
   "definizioa": "Euskaraz hitz egiten duen pertsona."
  },
  {
   "hitza": "IRAKURRI",
   "definizioa": "Liburu bateko hitzak begiekin ulertu."
  },
  {
   "hitza": "IDATZI",
   "definizioa": "Arkatzarekin hitzak paperean jarri."
  },
  {
   "hitza": "ENTZUN",
   "definizioa": "Belarriekin hotsak eta hitzak hartu."
  },
  {
   "hitza": "ABENDUA",
   "definizioa": "Euskararen Eguna hilabete honetako 3an ospatzen da."
  }
 ],
